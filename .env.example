# Copiar a .env y completar localmente. No contiene credenciales reales.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/sistema_calidad_aire
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_PRIVADO
IOT_API_KEY=REEMPLAZAR_POR_LA_CLAVE_DEL_ESP32
PORT=3000
API_PORT=5051
ML_PORT=8000
# Clave privada del servicio que registra modelos y evaluaciones en la API .NET.
# Debe ser distinta de IOT_API_KEY.
Ml__RegistroApiKey=
# Frecuencia del simulador y sensor real registrado en su base
SIMULADOR_INTERVALO_S=900
# SIMULADOR_SENSOR_ID=1
# Escrituras adicionales desactivadas hasta configurar el entorno
Ml__PersistenciaDemoHabilitada=false
CUARENTENA_REVISION_HABILITADA=false
ALERTAS_TECNICAS_HABILITADAS=false
ALERTAS_TECNICAS_AUTO=false
ALERTAS_SIN_DATOS_S=1800
Ml__PoliticaVersionadaHabilitada=true
ML_POLITICA_VERSIONADA=true
# Activar después de aplicar migraciones y preparar el registro local
ML_ENTRENAMIENTO_AUTO=false
ML_ARRANQUE_DEMO=false
ML_RESULTADOS_AUTO=false
ALERTAS_AMBIENTALES_AUTO=false
